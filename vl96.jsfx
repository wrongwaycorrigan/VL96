// reshaping the wave, so hot playing gets quieter rather than square and clicky
lpk = max(abs(spl0), abs(spl1));
lim_e = lpk > lim_e ? lpk : lim_e * lim_r;
lim_t = lim_e > 0.7 ? 0.7 / lim_e : 1;
lim_g += (lim_t - lim_g) * (lim_t < lim_g ? 0.5 : 0.002);
spl0 *= lim_g; spl1 *= lim_g;
abs(spl0) > 0.9 ? spl0 = sign(spl0) * (0.9 + 0.09 * tanh_((abs(spl0) - 0.9) / 0.09));
abs(spl1) > 0.9 ? spl1 = sign(spl1) * (0.9 + 0.09 * tanh_((abs(spl1) - 0.9) / 0.09));

@gfx 780 572
// ======================= custom interface =======================
// drag a knob up/down (Shift = fine), mouse wheel nudges, double-click resets.

function col(r, g, bb) ( gfx_r = r; gfx_g = g; gfx_b = bb; gfx_a = 1; );
function S(v) ( v * sc );

function preset_name(n) (
  n == 0 ? #pn = "Clarinet" : n == 1 ? #pn = "Sax" : n == 2 ? #pn = "Flute" : n == 3 ? #pn = "Oboe" : n == 4 ? #pn = "Shakuhachi" : #pn = "Sax II";
);

function knob_info(i) (
  i == 38 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.5;  #lbl = "REED";
              reedk < 0.4 ? sprintf(#val, "soft %d", (0.5 - reedk) * 20 + 0.5) : reedk > 0.6 ? sprintf(#val, "hard %d", (reedk - 0.5) * 20 + 0.5) : #val = "medium"; ) :
  i == 39 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = matn; #lbl = "MATERIAL";
              mat < 0.35 ? #val = "wood" : mat > 0.65 ? #val = "metal" : #val = "mixed"; ) :
  i == 3  ? ( kmin = 0.15; kmax = 0.45; kstep = 0.01;  kdef = 0.30; #lbl = "STIFFNESS";  sprintf(#val, "%.2f", stiff); ) :
  i == 4  ? ( kmin = 0.55; kmax = 0.80; kstep = 0.01;  kdef = 0.70; #lbl = "OPENING";    sprintf(#val, "%.2f", opening); ) :
  i == 19 ? ( kmin = 0.40; kmax = 0.52; kstep = 0.005; kdef = 0.46; #lbl = "LIP"; jetr < 0.445 ? #val = "tight" : jetr < 0.475 ? #val = "centred" : #val = "relaxed"; ) :
  i == 20 ? ( kmin = 0.80; kmax = 1.25; kstep = 0.01;  kdef = 1.00; #lbl = "PRESSURE"; sprintf(#val, "%d%%", airgain * 100 + 0.5); ) :
  i == 5  ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.5;  #lbl = "BRIGHT"; bright < 0.2 ? #val = "mellow" : bright < 0.4 ? #val = "soft" : bright < 0.6 ? #val = "clear" : bright < 0.8 ? #val = "bright" : #val = "brilliant"; ) :
  i == 12 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.30; #lbl = "BODY";       body < 0.05 ? #val = "none" : body < 0.3 ? #val = "light" : body < 0.6 ? #val = "full" : body < 0.85 ? #val = "rich" : #val = "big"; ) :
  i == 13 ? ( kmin = 400;  kmax = 3000; kstep = 10;    kdef = 1300; #lbl = "COLOUR";
              bodyf < 500 ? strcpy(#vw, "dark") : bodyf < 800 ? strcpy(#vw, "warm") : bodyf < 1200 ? strcpy(#vw, "round") : bodyf < 1900 ? strcpy(#vw, "reedy") : strcpy(#vw, "edge");
              strcpy(#val, #vw); ) :
  i == 7  ? ( kmin = 0;    kmax = 0.3;  kstep = 0.01;  kdef = 0.05; #lbl = "BREATHY";  noiseamt < 0.02 ? #val = "clean" : noiseamt < 0.07 ? #val = "light" : noiseamt < 0.14 ? #val = "airy" : noiseamt < 0.22 ? #val = "breathy" : #val = "very airy"; ) :
  i == 8  ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0;    #lbl = "GROWL";      growlp < 0.03 ? #val = "off" : growlp < 0.25 ? #val = "hint" : growlp < 0.5 ? #val = "rough" : growlp < 0.75 ? #val = "gritty" : #val = "heavy"; ) :
  i == 21 ? ( kmin = 0.30; kmax = 1;    kstep = 0.01;  kdef = 0.85; #lbl = "THRESHOLD";  sprintf(#val, "%d%%", gthr * 100 + 0.5); ) :
  i == 9  ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0;    #lbl = "VIBRATO";    vibp < 0.03 ? #val = "off" : vibp < 0.2 ? #val = "gentle" : vibp < 0.4 ? #val = "medium" : vibp < 0.65 ? #val = "wide" : #val = "very wide"; ) :
  i == 10 ? ( kmin = 3;    kmax = 8;    kstep = 0.1;   kdef = 5;    #lbl = "VIB RATE";   sprintf(#val, "%.1f Hz", vibrate); ) :
  i == 11 ? ( kmin = 0;    kmax = 300;  kstep = 1;     kdef = 4;    #lbl = "GLIDE";      glidems < 8 ? #val = "tight" : glidems < 40 ? #val = "quick" : glidems < 100 ? #val = "smooth" : #val = "slow"; ) :
  i == 16 ? ( kmin = 0;    kmax = 12;   kstep = 1;     kdef = 2;    #lbl = "BEND RANGE"; sprintf(#val, "%d st", bendrange); ) :
  i == 54 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0;    #lbl = "THROAT";
              throat < 0.02 ? #val = "relaxed" : throat < 0.3 ? #val = "low" : throat < 0.6 ? #val = "mid" : throat < 0.85 ? #val = "high" : #val = "focused"; ) :
  i == 52 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.35; #lbl = "RESO";
              reso < 0.03 ? #val = "off" : reso < 0.3 ? #val = "subtle" : reso < 0.6 ? #val = "vocal" : reso < 0.85 ? #val = "singing" : #val = "wah"; ) :
  i == 50 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.5;  #lbl = "ATTACK";
              artic < 0.15 ? #val = "very smooth" : artic < 0.4 ? #val = "smooth" : artic <= 0.6 ? #val = "natural" : artic < 0.85 ? #val = "crisp" : #val = "very crisp"; ) :
  i == 23 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.3;  #lbl = "SCOOP";
              scoop < 0.03 ? #val = "none" : scoop < 0.25 ? #val = "slight" : scoop < 0.55 ? #val = "medium" : #val = "deep"; ) :
  i == 24 ? ( kmin = 10;   kmax = 250;  kstep = 1;     kdef = 60;   #lbl = "SCOOP TIME"; sprintf(#val, "%d ms", scoopms); ) :
  i == 25 ? ( kmin = 0;    kmax = 1500; kstep = 10;    kdef = 250;  #lbl = "VIB DELAY";  vibdel < 10 ? #val = "none" : vibdel < 200 ? #val = "short" : vibdel < 500 ? #val = "medium" : #val = "long"; ) :
  i == 26 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.4;  #lbl = "TONGUE";
              tongue < 0.03 ? #val = "off" : tongue < 0.3 ? #val = "soft" : tongue < 0.6 ? #val = "medium" : #val = "hard"; ) :
  i == 42 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0;    #lbl = "SUBTONE";
              subamt < 0.03 ? #val = "off" : subamt < 0.35 ? #val = "hint" : subamt < 0.7 ? #val = "smooth" : #val = "lush"; ) :
  i == 27 ? ( kmin = 0;    kmax = 1;    kstep = 0.01;  kdef = 0.6;  #lbl = "BLOOM"; btone < 0.05 ? #val = "steady" : btone < 0.3 ? #val = "gentle" : btone < 0.6 ? #val = "open" : btone < 0.85 ? #val = "wide" : #val = "dramatic"; ) :
  i == 28 ? ( kmin = 0.7;  kmax = 1.6;  kstep = 0.01;  kdef = 1.2;  #lbl = "SENS"; sens < 0.95 ? #val = "hard" : sens < 1.3 ? #val = "medium" : #val = "soft"; ) :
  i == 29 ? ( kmin = 5;    kmax = 600;  kstep = 5;     kdef = 120;  #lbl = "RELEASE";    sprintf(#val, "%d ms", relms); ) :
  i == 17 ? ( kmin = -24;  kmax = 12;   kstep = 0.5;   kdef = 0;    #lbl = "LEVEL";
              gaindb >= 0 ? sprintf(#val, "+%.1f dB", gaindb) : sprintf(#val, "%.1f dB", gaindb); );
);

function knob(i, cx, cy) local(v, t, a, a0, a1, r, k, hit, now, tw, th) (
  knob_info(i);
  r = S(20);
  hit = sqr(mouse_x - cx) + sqr(mouse_y - cy) < sqr(r + S(9));
  (mouse_cap & 1) && !(last_cap & 1) && hit ? (
    now = time_precise();
    now - lastclick_t < 0.35 && lastclick_k == i ? (
      slider(i) = kdef; changed = i; drag = 0;
    ) : (
      drag = i; drag_y = mouse_y; drag_v = slider(i);
    );
    lastclick_t = now; lastclick_k = i;
  );
  drag == i && (mouse_cap & 1) ? (
    v = drag_v + (drag_y - mouse_y) / S((mouse_cap & 8) ? 900 : 180) * (kmax - kmin);
    v = max(kmin, min(kmax, floor(v / kstep + 0.5) * kstep));
    v != slider(i) ? ( slider(i) = v; changed = i; );
  );
  hit && mouse_wheel != 0 && !drag ? (
    v = slider(i) + sign(mouse_wheel) * kstep * ((kmax - kmin) / kstep > 60 ? 4 : 1);
    slider(i) = max(kmin, min(kmax, v)); changed = i; mouse_wheel = 0;
  );
  knob_info(i);
  t = (slider(i) - kmin) / (kmax - kmin);
  a0 = -2.36; a1 = 2.36; a = a0 + t * (a1 - a0);
  col(0.17, 0.18, 0.20); gfx_circle(cx, cy, r, 1, 1);
  col(0.30, 0.31, 0.34); gfx_circle(cx, cy, r, 0, 1);
  k = 0; loop(3, gfx_arc(cx, cy, r + S(5) + k, a0, a1, 1); k += 1; );
  (hit || drag == i) ? col(0.58, 0.80, 1.0) : col(0.30, 0.62, 0.98);
  k = 0; loop(3, gfx_arc(cx, cy, r + S(5) + k, a0, a, 1); k += 1; );
  col(0.95, 0.94, 0.90);
  gfx_line(cx + sin(a) * r * 0.30, cy - cos(a) * r * 0.30, cx + sin(a) * r * 0.88, cy - cos(a) * r * 0.88, 1);
  gfx_setfont(2); col(0.60, 0.61, 0.65);
  gfx_measurestr(#lbl, tw, th); gfx_x = cx - tw / 2; gfx_y = cy + r + S(10); gfx_drawstr(#lbl);
  gfx_setfont(3); col(0.93, 0.92, 0.88);
  gfx_measurestr(#val, tw, th); gfx_x = cx - tw / 2; gfx_y = cy + r + S(24); gfx_drawstr(#val);
);

function seg(i, n, x, y, w, h) local(k, bx, bw, sel, hov, tw, th) (
  bw = w / n; k = 0;
  loop(n,
    bx = x + k * bw; sel = slider(i) == k;
    hov = mouse_x >= bx && mouse_x < bx + bw && mouse_y >= y && mouse_y < y + h;
    (mouse_cap & 1) && !(last_cap & 1) && hov ? ( slider(i) = k; changed = i; sel = 1; );
    sel ? col(0.30, 0.62, 0.98) : hov ? col(0.28, 0.29, 0.32) : col(0.21, 0.22, 0.24);
    gfx_rect(bx + 1, y, bw - 2, h);
    i == 22 ? ( k == 0 ? #lbl = "OFF" : k == 1 ? #lbl = "LOW" : #lbl = "HIGH"; )
            : ( k == 0 ? #lbl = "AUTO" : k == 1 ? #lbl = "CC2" : k == 2 ? #lbl = "CC11" : #lbl = "VEL"; );
    gfx_setfont(2); sel ? col(0.10, 0.10, 0.11) : col(0.76, 0.77, 0.80);
    gfx_measurestr(#lbl, tw, th); gfx_x = bx + (bw - tw) / 2; gfx_y = y + (h - th) / 2; gfx_drawstr(#lbl);
    k += 1;
  );
);

function button(x, y, w, h, txt) local(hov, tw, th) (
  hov = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  hov ? col(0.28, 0.29, 0.32) : col(0.21, 0.22, 0.24); gfx_rect(x, y, w, h);
  gfx_setfont(2); col(0.85, 0.85, 0.87);
  gfx_measurestr(txt, tw, th); gfx_x = x + (w - tw) / 2; gfx_y = y + (h - th) / 2; gfx_drawstr(txt);
  hov && (mouse_cap & 1) && !(last_cap & 1);
);

function group(x, y, w, h, name) (
  col(0.17, 0.175, 0.19); gfx_rect(x, y, w, h);
  col(0.25, 0.26, 0.28); gfx_roundrect(x, y, w, h, S(6), 1);
  gfx_setfont(2); col(0.30, 0.62, 0.98); gfx_x = x + S(10); gfx_y = y + S(7); gfx_drawstr(name);
);

function choose_preset(n) (
  preset = max(0, min(5, n)); lastpreset = preset;
  apply_preset(preset); sliderchange(2^48 - 1); slider_automate(2^17);
);

sc = max(0.6, min(gfx_w / 780, gfx_h / 572));
gfx_setfont(1, "Arial", S(24), 'b');
gfx_setfont(2, "Arial", S(11), 'b');
gfx_setfont(3, "Arial", S(12));
gfx_setfont(4, "Arial", S(15), 'b');
changed = 0;

// background + header
col(0.11, 0.115, 0.125); gfx_rect(0, 0, gfx_w, gfx_h);
col(0.145, 0.15, 0.165); gfx_rect(0, 0, gfx_w, S(56));
col(0.30, 0.62, 0.98); gfx_rect(0, S(56), gfx_w, S(2));
gfx_setfont(1); col(0.95, 0.93, 0.88); gfx_x = S(18); gfx_y = S(15); gfx_drawstr("VL");
col(0.30, 0.62, 0.98); gfx_drawstr("96");
gfx_setfont(2); col(0.50, 0.51, 0.55); gfx_x += S(8); gfx_y = S(25); gfx_drawstr("v1.42");

// preset selector:  [<]  name  [>]   (click the name for the full list)
gfx_setfont(2); col(0.50, 0.51, 0.55); gfx_x = S(318); gfx_y = S(6); gfx_drawstr("PRESET");
button(S(318), S(22), S(26), S(24), "<") ? choose_preset(preset == 0 ? 5 : preset - 1);
button(S(492), S(22), S(26), S(24), ">") ? choose_preset(preset == 5 ? 0 : preset + 1);
hovn = mouse_x >= S(346) && mouse_x < S(490) && mouse_y >= S(22) && mouse_y < S(46);
hovn ? col(0.24, 0.25, 0.28) : col(0.18, 0.19, 0.21); gfx_rect(S(346), S(22), S(144), S(24));
preset_name(preset); gfx_setfont(4); col(0.30, 0.62, 0.98);
gfx_measurestr(#pn, tw, th); gfx_x = S(418) - tw / 2; gfx_y = S(22) + (S(24) - th) / 2; gfx_drawstr(#pn);
hovn && (mouse_cap & 1) && !(last_cap & 1) ? (
  gfx_x = S(346); gfx_y = S(48);
  pick = gfx_showmenu("Clarinet|Sax|Flute|Oboe|Shakuhachi|Sax II (two-tube)");
  pick > 0 ? choose_preset(pick - 1);
);

gfx_setfont(2); col(0.50, 0.51, 0.55); gfx_x = S(540); gfx_y = S(6); gfx_drawstr("BREATH SOURCE");
seg(2, 4, S(540), S(22), S(226), S(24));

// breath meter + note (left column, full height)
group(S(14), S(70), S(80), S(492), "BREATH");
col(0.08, 0.085, 0.09); gfx_rect(S(38), S(96), S(32), S(390));
gthr_y = S(96) + S(390) * (1 - gthr);
mh = S(390) * min(1, b);
col(0.30, 0.62, 0.98); gfx_rect(S(38), S(96) + S(390) - mh, S(32), mh);
growlp > 0 ? ( col(0.90, 0.30, 0.25); gfx_rect(S(32), gthr_y - 1, S(44), S(2)); );
col(0.85, 0.92, 1.0); gfx_rect(S(70), S(96) + S(390) * (1 - bth) - 1, S(8), S(2));   // SENS: where the bloom begins
gotnote ? (
  ni = lastnote % 12; oct = floor(lastnote / 12) - 1;
  strcpy_substr(#nn, "CCDDEFFGGAAB", ni, 1);
  (ni == 1 || ni == 3 || ni == 6 || ni == 8 || ni == 10) ? sprintf(#note, "%s#%d", #nn, oct) : sprintf(#note, "%s%d", #nn, oct);
) : #note = "--";
gfx_setfont(1); col(0.95, 0.93, 0.88); gfx_measurestr(#note, tw, th);
gfx_x = S(54) - tw / 2; gfx_y = S(500); gfx_drawstr(#note);
gfx_setfont(2); col(0.50, 0.51, 0.55);
seen2 ? #src = "CC2 IN" : #src = "NO CC2"; gfx_measurestr(#src, tw, th);
gfx_x = S(54) - tw / 2; gfx_y = S(536); gfx_drawstr(#src);

// panels follow the path of the air: bore -> instrument -> tone -> air -> articulation
// -> motion -> dynamics -> output

// row 1: bore, instrument, tone
group(S(104), S(70), S(234), S(126), "BORE");
model == 0 ? #bn = "Cylinder" : model == 1 ? (twot ? #bn = "Conical (two-tube)" : #bn = "Conical") : #bn = "Jet";
// Lissajous of the pressure inside the tube against itself a quarter-cycle later:
// a pure tone draws a circle, each harmonic bends it - the shape is the timbre
sp_n = min(1000, floor(3 * srate / max(40, freq)));          // about three cycles
sp_q = max(1, floor(srate / max(40, freq) / 4 + 0.5));       // quarter period
sp_m = 0.0001; sp_mean = 0; k = 0; sp_i = sci - sp_n - sp_q; sp_i < 0 ? sp_i += scn;
loop(sp_n + sp_q, sp_mean += scb[sp_i]; sp_i += 1; sp_i >= scn ? sp_i -= scn; );
sp_mean /= (sp_n + sp_q); sp_i = sci - sp_n - sp_q; sp_i < 0 ? sp_i += scn;
loop(sp_n + sp_q, sp_m = max(sp_m, abs(scb[sp_i] - sp_mean)); sp_i += 1; sp_i >= scn ? sp_i -= scn; );
sp_cx = S(268); sp_cy = S(136); sp_r = S(22) + S(24) * min(1, amp * 1.4);   // breathes with your playing
sp_m > 0.0005 ? (
  // draw twice: a soft wide glow, then a bright core; each pass also drawn mirrored (kaleidoscope)
  pass = 0;
  loop(2,
    mir = 0;
    loop(2,
      sp_i = sci - sp_n; sp_i < 0 ? sp_i += scn; k = 0;
      loop(sp_n,
        sp_j = sp_i - sp_q; sp_j < 0 ? sp_j += scn;
        u = (scb[sp_i] - sp_mean) / sp_m; v = (scb[sp_j] - sp_mean) / sp_m;
        mir ? ( u = -u; v = -v; );
        px = sp_cx + u * sp_r; py = sp_cy - v * sp_r;
        fade = k / sp_n;
        pass == 0 ? ( gfx_r = 0.15; gfx_g = 0.45; gfx_b = 0.96; gfx_a = 0.10 * fade; )
                  : ( gfx_r = 0.30 + 0.4 * fade; gfx_g = 0.72 + 0.2 * fade; gfx_b = 1.0; gfx_a = (mir ? 0.35 : 0.9) * fade; );
        k > 0 ? ( pass == 0 ? ( gfx_line(lx, ly, px, py, 1); gfx_line(lx + 1, ly, px + 1, py, 1); gfx_line(lx, ly + 1, px, py + 1, 1); )
                            : gfx_line(lx, ly, px, py, 1); );
        lx = px; ly = py; k += 1; sp_i += 1; sp_i >= scn ? sp_i = 0;
      );
      mir += 1;
    );
    pass += 1;
  );
  gfx_a = 1;
) : ( col(0.35, 0.36, 0.40); gfx_circle(sp_cx, sp_cy, S(2), 1, 1); );
gfx_setfont(4); col(0.93, 0.92, 0.88); gfx_x = S(118); gfx_y = S(160); gfx_drawstr(#bn);
group(S(346), S(70), S(168), S(126), "INSTRUMENT");
model == 2 ? knob(19, S(392), S(118)) : knob(38, S(392), S(118));
knob(39, S(468), S(118));
group(S(522), S(70), S(244), S(126), "TONE");
knob(5,  S(568), S(118)); knob(12, S(644), S(118)); knob(13, S(720), S(118));

// row 2: air, articulation
group(S(104), S(202), S(327), S(126), "AIR & GROWL");
knob(7,  S(146), S(250)); knob(8,  S(222), S(250)); knob(21, S(298), S(250)); knob(42, S(374), S(250));
group(S(439), S(202), S(327), S(126), "ARTICULATION");
knob(50, S(602), S(250));

// row 3: motion, dynamics
group(S(104), S(334), S(420), S(126), "MOTION");
knob(9,  S(150), S(382)); knob(10, S(226), S(382)); knob(25, S(302), S(382));
knob(11, S(378), S(382)); knob(16, S(454), S(382));
group(S(532), S(334), S(234), S(126), "DYNAMICS");
knob(27, S(578), S(382)); knob(28, S(650), S(382)); knob(52, S(722), S(382));

// row 4: output
group(S(104), S(466), S(662), S(96), "OUTPUT");
// studio: a three-position switch (off / low / high)
// STUDIO EFFECTS: three tiers, labelled like a knob (name + current setting underneath)
seg(22, 3, S(122), S(494), S(210), S(26));
gfx_setfont(2); col(0.60, 0.61, 0.65); gfx_measurestr("STUDIO EFFECTS", tw, th);
gfx_x = S(227) - tw / 2; gfx_y = S(530); gfx_drawstr("STUDIO EFFECTS");
fx == 0 ? #fxs = "off (dry)" : fx == 1 ? #fxs = "drive + comp + plate" : #fxs = "more drive, presence, width";
gfx_setfont(3); col(0.93, 0.92, 0.88); gfx_measurestr(#fxs, tw, th);
gfx_x = S(227) - tw / 2; gfx_y = S(544); gfx_drawstr(#fxs);
knob(17, S(712), S(500));

!(mouse_cap & 1) ? drag = 0;
last_cap = mouse_cap;
changed ? ( update_params(); slider_automate(2 ^ (changed - 1)); );
