desc:VL96 - waveguide wind instrument (breath controlled)
//tags: instrument synthesis physical-modeling wind
//author: 
//
// Original digital-waveguide wind models in the spirit of early-90s physical
// modelling synths. Not a copy of any product.
//   - cylindrical reed (clarinet family)
//   - conical reed, approximated (saxes, double reeds)
//   - air jet across an edge (flutes, shakuhachi, pan flute, recorder)
//
// Play with a wind controller sending breath on CC2 (or CC11), or a keyboard
// (velocity mode). CC1 adds growl on top of the breath-triggered growl.
// Monophonic with legato glide.

slider1:model=0<0,2,1{Cylindrical reed,Conical reed,Air jet}>-Model
slider2:bsrc=0<0,3,1{Auto (CC2 if received),Breath CC2,Expression CC11,Velocity}>-Breath Source
slider3:stiff=0.31<0.15,0.45,0.01>-Reed Stiffness
slider4:opening=0.69<0.55,0.80,0.01>-Reed Opening
slider5:bright=0.542<0,1,0.01>-Brightness
slider7:noiseamt=0.05<0,0.3,0.01>-Air Noise
slider8:growlp=0<0,1,0.01>-Growl Amount
slider9:vibp=0.25<0,1,0.01>-Vibrato Depth
slider10:vibrate=4.6<3,8,0.1>-Vibrato Rate (Hz)
slider11:glidems=4<0,300,1>-Legato Glide (ms)
slider12:body=0.595<0,1,0.01>-Body Resonance
slider13:bodyf=430<400,3000,10>-Body Frequency (Hz)
slider16:bendrange=2<0,12,1>-Pitch Bend Range (semitones)
slider17:gaindb=0<-24,12,0.5>-Output (dB)
slider18:preset=0<0,5,1{Clarinet,Sax,Flute,Oboe,Shakuhachi,Sax II (two-tube)}>-Preset
slider19:jetr=0.46<0.40,0.52,0.005>-Embouchure (jet length)
slider20:airgain=1<0.8,1.25,0.01>-Air Pressure
slider21:gthr=0.92<0.30,1,0.01>-Growl Threshold
slider22:fx=0<0,2,1{Off,Low,High}>-Studio (Off / Low: drive + comp + plate / High: more drive, presence, width)
slider23:scoop=0.1<0,1,0.01>-Attack Scoop (x100 cents)
slider24:scoopms=40<10,250,1>-Scoop Time (ms)
slider25:vibdel=300<0,1500,10>-Vibrato Delay (ms)
slider26:tongue=0.35<0,1,0.01>-Tonguing
slider27:btone=0.481<0,1,0.01>-Breath > Tone
slider28:sens=1.2<0.7,1.6,0.01>-Sens: where the bloom begins (soft = early, hard = only when pushed)
slider29:relms=120<5,600,1>-Release (ms)
slider30:cpos=0.42<0.30,0.45,0.01>-Cone Reed Position
slider31:f2f=2400<800,4000,10>-Formant 2 (Hz)
slider32:f2a=0<0,1,0.01>-Formant 2 Amount
slider33:hpf=0<0,1200,10>-Low Cut (Hz)
slider34:pairhi=0<0,2,1{Lowest,Highest,Off (every note)}>-Paired notes play
slider38:reedk=0.5<0,1,0.01>-Reed (soft..hard)
slider39:mat=0.2<0,1,0.01>-Material (wood..metal)
slider40:matn=0.2<0,1,0.01>-Native Material (preset)
slider43:bell=0<0,1,0.01>-Bell Radiation (0 = inside tube, 1 = radiated)
slider44:drift=2.2<0,10,0.1>-Pitch Life (cents)
slider45:thfc=1150<800,3000,10>-Tone-hole Cutoff (Hz)
slider46:thmix=0.055<0,1,0.01>-Tone-hole Radiation
slider47:rsoft=1<0,1,1{Hard,Rounded}>-Reed Closure
slider48:ftune=0<-50,50,0.1>-Preset Fine Tune (cents)
slider41:twot=0<0,1,1{Single loop,Two-tube}>-Cone Model
slider49:apex=0.15<0.04,0.45,0.005>-Two-tube Apex Ratio
slider50:artic=0.5<0,1,0.01>-Attack (smooth..crisp)
slider51:life=1<0,1,0.01>-Breath Turbulence (cycle-to-cycle wobble)
slider52:reso=0.35<0,1,0.01>-Reso: breath-swept resonance (like breath > filter resonance)
slider53:throat=0<0,1,0.01>-Throat depth (experimental, follows breath; off in all presets)
slider54:airhf=0.5<0,2,0.01>-High air: bright breath rush, pulsing with the tone (per preset)
slider42:subamt=0<0,1,0.01>-Subtone
slider37:trim=-2<-12,12,0.1>-Preset Level Trim (dB)
slider36:kcut=40<2,40,0.1>-Tone Ceiling (harmonics)
slider35:even=0.681<0,1,0.01>-Even Harmonics

in_pin:none
out_pin:left
out_pin:right

@init
N = 8192;              // bore delay line
buf = 0;               // bore:  buf[0..N-1]
jbuf = 10000;          // jet:   jbuf[0..N-1]
stk = 20000;           // held-note stack
memset(buf, 0, N); memset(jbuf, 0, N);
nheld = 0; wi = 0;
lp = 0; dcx = 0; dcy = 0;
bx1 = bx2 = by1 = by2 = 0;
L = 100; Lt = 100; snap = 1;
b = 0; bm = 0; amp = 0; venv = 0; vtarget = 0;
pv = 0; pg = 0; asymavg = 0;
freq = 220; pbend = 0; cc1 = 0;
breathcc = 0; exprcc = 0; seen2 = 0; seen11 = 0;
lastnote = 62; gotnote = 0; lastpreset = -1; spos = 0; lastontime = -100000; paired = 0; pendt = -1; pendnote = 62; bhold = 0;
scenv = 0; tgenv = 0; vt = 0; dic1 = dic2 = dic3 = dic4 = 0;
tg_k = exp(-1 / (0.018 * srate));    // tongue transient ~18 ms
pmax = 0.96;                          // reed choke point (fixed)
cone_t = 0;                           // conical tuning trim (calibrated)
k1 = 1 - exp(-1 / (0.004 * srate)); ks = 1 - exp(-1 / (0.012 * srate));
hold_k = exp(-1 / (0.6 * srate));   // pressure memory falls over ~0.6 s   // breath smoothing (~4 ms)
ka = 1 - exp(-1 / (0.025 * srate));   // velocity-mode attack
kr = 1 - exp(-1 / (0.120 * srate));   // velocity-mode release

function update_params() (
  c = 0.1 + 0.85 * bright;
  bf = bodyf;
  w0 = 2 * $pi * bf / srate; al = sin(w0) / (2 * 1.3); a0 = 1 + al;
  cb0 = al / a0; cb2 = -al / a0; ca1 = -2 * cos(w0) / a0; ca2 = (1 - al) / a0;
  glide_k = 1 - exp(-1 / (max(0.5, glidems) * 0.001 * srate));
  vfo_k = 1 - exp(-1 / (0.025 * srate));
  outgain = 10 ^ ((gaindb + trim - 4) / 20);    // -4 dB internal pad: healthy level, limiter guards the top
  // one-knob reed: moves stiffness and opening together along the playable band
  rkd = (reedk - 0.5) * (reedk < 0.5 ? 0.03 : 0.06);
  stiffe = stiff + rkd; openinge = opening - rkd;
  // material: change relative to the preset's own material
  md = mat - matn;
  mlk = 1 - exp(-2 * $pi * 3000 / srate);              // tilt split at ~3 kHz
  rw1 = 2 * $pi * 2650 / srate; ra1 = sin(rw1) / (2 * 14); rn1 = 1 + ra1;
  r1b0 = ra1 / rn1; r1a1 = -2 * cos(rw1) / rn1; r1a2 = (1 - ra1) / rn1;
  rw2 = 2 * $pi * 4400 / srate; ra2 = sin(rw2) / (2 * 14); rn2 = 1 + ra2;
  r2b0 = ra2 / rn2; r2a1 = -2 * cos(rw2) / rn2; r2a2 = (1 - ra2) / rn2;
  jofs = 0.4 * even * (0.16 * even * even - 1);
  mgain = model == 1 ? (f2a > 0.5 ? 0.75 : 0.95) : 1;   // level-match the conical voices
  w2 = 2 * $pi * f2f / srate; al2 = sin(w2) / (2 * 2.0); a02 = 1 + al2;
  db0 = al2 / a02; db2 = -al2 / a02; da1f = -2 * cos(w2) / a02; da2f = (1 - al2) / a02;
  hp_k = hpf > 0 ? 1 - exp(-2 * $pi * hpf / srate) : 0;
  // ATTACK: one knob from smooth (lazy scoop, soft breathy onset, long release) to crisp
  // (no scoop, clear tongue, short release); the middle is the preset as voiced
  // SENS: where the bloom begins - medium sits just above normal playing, soft lower, hard near the top
  bth = sens <= 1.2 ? 0.92 - 0.12 * (sens - 0.7) / 0.5 : 0.80 - 0.25 * (sens - 1.2) / 0.4;
  // (throat chamber: tuned per sample from breath, see the reed section)
  ad = artic - 0.5;
  scoopE = ad < 0 ? scoop + (-2 * ad) * (max(scoop, 0.45) - scoop) : scoop * (1 - 2 * ad);
  tongueE = ad < 0 ? tongue * (1 + 1.7 * ad) : tongue + 2 * ad * (max(tongue, 0.8) - tongue);
  relE = max(25, relms * 2 ^ (-2.6 * ad));
  rel_k = exp(-4.6 / (relE * 0.001 * srate));  // level falls 40 dB over the release time
  scoopms = 30 + 170 * scoopE;                              // deeper scoops are also slower, like a player's
  sc_k = exp(-2.3 / (max(10, scoopms) * 0.001 * srate));
  // jet-model tuning, fitted from measurements: period = ja*L + jb
  ja = 0.1452 + 1.6779 * jetr + 0.7581 * airgain - 1.4815 * jetr * airgain;
  jb0 = -2.487 + 11.60 * jetr - 3.276 * airgain;     // + 0.631*(1-c)/c, added per sample
);

// preset table:  model, reed or jet settings, tone, breath, motion
function apply_preset(n) (
  artic = 0.5; reso = 0.35;
  // tone settings fitted to measured harmonic profiles of early-90s physical-model wind presets
  n == 0 ? (model=0; stiff=0.31; opening=0.69; bright=0.542; even=0.681; noiseamt=0.05; growlp=0.0; gthr=0.92; vibp=0.25; vibrate=4.6; glidems=4; body=0.595; bodyf=430; f2a=0; hpf=0; scoop=0.10; scoopms=40; vibdel=300; tongue=0.35; btone=0.481; relms=120; kcut=40; trim=-2; matn=0.2; mat=0.2; reedk=0.5; subamt=0; bell=0; drift=2.2; thmix=0.055; thfc=1150; rsoft=1; ftune=0; life=1; throat=0; airhf=0.5;) :
  n == 1 ? (model=1; stiff=0.27; opening=0.66; bright=1; even=0; noiseamt=0.08; growlp=0.15; gthr=0.92; vibp=0.30; vibrate=4.4; glidems=4; body=0.986; bodyf=1500; cpos=0.42; f2f=2700; f2a=0.499; hpf=0; scoop=0.35; scoopms=70; vibdel=300; tongue=0.45; btone=0.519; relms=150; kcut=5.002; trim=2.9; matn=0.85; mat=0.85; reedk=0.5; subamt=0.85; bell=0.615; drift=2.2; thmix=0; rsoft=0; ftune=0; twot=0; life=1; throat=0; airhf=0.6;) :
  n == 2 ? (model=2; jetr=0.46; airgain=1.00; bright=0.4; even=0.281; noiseamt=0.038; growlp=0.0; gthr=0.95; vibp=0.35; vibrate=4.8; glidems=4; body=0.9; bodyf=2230; f2a=0; hpf=0; scoop=0.20; scoopms=60; vibdel=250; tongue=0.50; btone=0.68; relms=180; kcut=5.543; trim=0.4; matn=0.8; mat=0.8; reedk=0.5; subamt=0; bell=0; drift=2.8; thmix=0; rsoft=0; ftune=-1; life=0; throat=0; airhf=1.0;) :
  n == 3 ? (model=1; stiff=0.34; opening=0.64; bright=0.955; even=0; noiseamt=0.04; growlp=0.0; gthr=0.95; vibp=0.30; vibrate=4.6; glidems=4; body=1; bodyf=1320; cpos=0.40; f2f=2440; f2a=0.32; hpf=540; scoop=0.15; scoopms=50; vibdel=300; tongue=0.30; btone=0.607; relms=100; kcut=24.627; trim=-2; matn=0.15; mat=0.15; reedk=0.5; subamt=0; bell=0.023; drift=2.5; thmix=0; rsoft=1; ftune=0; twot=0; life=1; throat=0; airhf=0.35;) :
  n == 4 ? (model=2; jetr=0.459; airgain=1.0; bright=0.386; even=0.295; noiseamt=0.132; growlp=0.12; gthr=0.92; vibp=0.12; vibrate=3.8; glidems=4; body=0.603; bodyf=1300; f2a=0; hpf=0; scoop=0.40; scoopms=120; vibdel=400; tongue=0.30; btone=0.325; relms=200; kcut=4.353; trim=0; matn=0.0; mat=0.0; reedk=0.5; subamt=0; bell=0; drift=3.0; thmix=0; rsoft=0; ftune=0; life=0; throat=0; airhf=1.2;) :
  n == 5 ? (model=1; stiff=0.347; opening=0.615; bright=0.881; even=0; noiseamt=0.08; growlp=0.15; gthr=0.92; vibp=0.30; vibrate=4.4; glidems=4; body=0.315; bodyf=1460; cpos=0.449; f2f=2490; f2a=0.388; hpf=450; scoop=0.35; scoopms=70; vibdel=300; tongue=0.45; btone=0.667; relms=150; kcut=8; trim=-2.3; matn=0.85; mat=0.85; reedk=0.5; subamt=0.85; bell=0.604; drift=2.2; thmix=0; rsoft=0; ftune=0; apex=0.28; twot=1; life=1; throat=0; airhf=0.6;) ;
  update_params();
);

function tanh_(x) local(t) (
  x > 10 ? x = 10; x < -10 ? x = -10;
  t = exp(2 * x);
  (t - 1) / (t + 1);
);

// fractional delay read with a first-order allpass (Thiran) interpolator, after J.O. Smith:
// the delay is split into whole samples plus a fraction between 0.5 and 1.5, and the allpass
// supplies the fraction with a flat response - no note-dependent dulling, unlike linear blending
// when the whole-sample part steps (during glide / note changes) the allpass memory is
// re-seeded with what the new tap position would have output, so the step makes no click
function rda(bufp, len) instance(yp, pn) local(n0, d, a, i0, i1, y, r, j0, j1, f) (
  n0 = floor(len - 0.5); n0 < 1 ? n0 = 1; d = len - n0;
  a = (1 - d) / (1 + d);
  i0 = wi - n0; i0 < 0 ? i0 += N;
  i1 = i0 - 1; i1 < 0 ? i1 += N;
  n0 != pn ? (
    r = wi - 1 - len; r < 0 ? r += N;
    j0 = floor(r); f = r - j0; j1 = j0 + 1; j1 >= N ? j1 -= N;
    yp = bufp[j0] + (bufp[j1] - bufp[j0]) * f;
    pn = n0;
  );
  y = a * bufp[i0] + bufp[i1] - a * yp; yp = y;
  y;
);
function rd(bufp, len) local(ri, i0, i1, fr) (
  ri = wi - len; ri < 0 ? ri += N;
  i0 = floor(ri); fr = ri - i0;
  i1 = i0 + 1; i1 >= N ? i1 -= N;
  bufp[i0] + (bufp[i1] - bufp[i0]) * fr;
);


// ---- studio FX: saturation -> compressor -> small plate reverb
// Plate: the classic figure-eight "tank" topology from the public 1997 AES paper
// on effect design (input diffusers -> two cross-coupled decaying loops).
function dl_init(len) instance(bp, n, w) ( bp = mp; n = len; w = 0; memset(bp, 0, n); mp += n + 16; );
function dl_push(x) instance(bp, n, w) ( bp[w] = x; w += 1; w >= n ? w = 0; );
function dl_tap(d) instance(bp, n, w) local(r) ( r = w - floor(d); r < 0 ? r += n; bp[r]; );
function dl_tapf(d) instance(bp, n, w) local(r, i0, i1, fr) (
  r = w - d; r < 0 ? r += n; i0 = floor(r); fr = r - i0; i1 = i0 + 1; i1 >= n ? i1 = 0;
  bp[i0] + (bp[i1] - bp[i0]) * fr;
);
function ap_init(len) instance(D) ( D = len; this.dl_init(len + 2); );
function ap(x, g) instance(D) local(dd, v) ( dd = this.dl_tap(D); v = x - g * dd; this.dl_push(v); dd + g * v; );
function apm(x, g, d) local(dd, v) ( dd = this.dl_tapf(d); v = x - g * dd; this.dl_push(v); dd + g * v; );

ps = srate / 29761;            // paper's reference rate
pz = ps * 0.80;                // smaller tank = small plate
lim_r = exp(-1 / (0.12 * srate)); lim_g = 1; vel01 = 0.8; ons = 100000; retg = 0; lastofft = -100000;
ob_k = exp(-1 / (0.04 * srate)); tb_k = exp(-1 / (0.035 * srate)); ah_o = 0.09; ah_t = 0.5;
ah_k1 = 1 - exp(-2 * $pi * 1800 / srate); ah_k2 = 1 - exp(-2 * $pi * 6500 / srate); ah_g = 0.035;
pr_k = 1 - exp(-2 * $pi * 2500 / srate); wd_k = 1 - exp(-2 * $pi * 1800 / srate);
wd_n = floor(0.0007 * srate); fxh2 = 0; prl = wdh = 0;
mp = 30000;
pre.dl_init(ceil(0.010 * srate) + 4); pre_d = ceil(0.010 * srate);
id1.ap_init(floor(142 * ps)); id2.ap_init(floor(107 * ps));
id3.ap_init(floor(379 * ps)); id4.ap_init(floor(277 * ps));
exc = 8 * ps;
mL.dl_init(ceil(672 * pz + exc) + 4); mL_D = 672 * pz;
dL1.dl_init(ceil(4453 * pz)); aL.ap_init(floor(1800 * pz)); dL2.dl_init(ceil(3720 * pz));
mR.dl_init(ceil(908 * pz + exc) + 4); mR_D = 908 * pz;
dR1.dl_init(ceil(4217 * pz)); aR.ap_init(floor(2656 * pz)); dR2.dl_init(ceil(3163 * pz));
wdd.dl_init(ceil(0.002 * srate) + 4);   // studio HIGH width delay
pl_decay = 0.42; pl_damp = 0.40; pl_bw = 0.70;
pl_in = 0; pl_sL = 0; pl_sR = 0; pl_endL = 0; pl_endR = 0; pl_ph = 0;
cenv = 0; fxm = 0; sdx = sdy = 0;
nk_t = 1 - exp(-2 * $pi * 1200 / srate); nk_h = 1 - exp(-2 * $pi * 600 / srate);
nk_b = 1 - exp(-2 * $pi * 3500 / srate); nk_g = 1 - exp(-2 * $pi * 120 / srate);
nk_j = 1 - exp(-2 * $pi * 150 / srate); nk_s = 1 - exp(-2 * $pi * 600 / srate); ns_n = 1.6 / sqrt(nk_s);   // breath turbulence on the blowing pressure nj_n = 2.2 / sqrt(nk_j);
nt_n = sqrt((2 - nk_t) / nk_t); nb_n = 1.6 * sqrt((2 - nk_b) / nk_b); ng_n = sqrt((2 - nk_g) / nk_g);
scb = 200000; scn = 4096; sci = 0; memset(scb, 0, scn);   // scope buffer for the BORE display
// Studio FX EQ: low cut ~28 Hz (24 dB/oct), +1.2 dB @100 Hz, -1.8 dB @380 Hz, +1.1 dB air @9 kHz
function bq_hp(fc, q) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(w, al, a0) (
  w = 2 * $pi * fc / srate; al = sin(w) / (2 * q); a0 = 1 + al;
  b0 = (1 + cos(w)) / 2 / a0; b1 = -(1 + cos(w)) / a0; b2 = b0; a1 = -2 * cos(w) / a0; a2 = (1 - al) / a0;
  x1 = x2 = y1 = y2 = 0;
);
function bq_peak(fc, q, db) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(w, al, A, a0) (
  A = 10 ^ (db / 40); w = 2 * $pi * fc / srate; al = sin(w) / (2 * q); a0 = 1 + al / A;
  b0 = (1 + al * A) / a0; b1 = -2 * cos(w) / a0; b2 = (1 - al * A) / a0; a1 = b1; a2 = (1 - al / A) / a0;
  x1 = x2 = y1 = y2 = 0;
);
function bq(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
c_att = 1 - exp(-1 / (0.015 * srate)); c_rel = 1 - exp(-1 / (0.150 * srate));
rv_hp = 0;

update_params();

@slider
lastpreset < 0 ? lastpreset = preset : preset != lastpreset ? (
  lastpreset = preset; apply_preset(preset); sliderchange(2^48 - 1);
);
update_params();

@block
// a note-off that uncovers another held note takes effect a moment later, so releasing a
// pair of notes together never jumps to the other note of the pair
pendt >= 0 && spos >= pendt ? ( lastnote = pendnote; freq = 440 * 2 ^ ((pendnote - 69) / 12); pendt = -1; );
while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 && pairhi < 2 && nheld > 0 && spos + ofs - lastontime < 0.004 * srate && !(pairhi ? m2 > stk[nheld - 1] : m2 < stk[nheld - 1]) ? (
    // second note of a pair sent together (e.g. the AE-20's two-part output): keep it held,
    // but keep sounding the chosen one (lowest by default) without re-articulating
    stk[nheld] = stk[nheld - 1]; stk[nheld - 1] = m2; nheld += 1;
  ) : st == 0x90 && m3 > 0 ? (
    paired = pairhi < 2 && nheld > 0 && spos + ofs - lastontime < 0.004 * srate;
    pendt = -1;
    lastontime = spos + ofs;
    // every note-on is its own entry (a pitch can be held twice - e.g. slurring up a fourth with
    // AE-20 pairs re-sends the old pair's upper note); keep the stack bounded
    nheld >= 30 ? ( i = 0; while (i < nheld - 1) ( stk[i] = stk[i + 1]; i += 1; ); nheld -= 1; );
    // a note-on arriving within 3 ms of the last note-off is a slur, even if the note-off came
    // first and the stack was momentarily empty (same-instant MIDI can arrive in either order);
    // real tonguing leaves a gap of tens of ms
    snap = ((nheld == 0 && spos + ofs - lastofft > 0.003 * srate) || (paired && snap)) ? 1 : 0;
    snap && !paired ? ( scenv = 1; tgenv = 0.45 + 1.1 * (m3 / 127); pv = 0; vel01 = m3 / 127; ons = 0; tgb = tgenv; retg = amp > 0.08;   // re-tongued while still sounding?   // velocity = accent     // fresh (tongued) attack: scoop + tongue
             memset(buf, 0, N); memset(jbuf, 0, N); lp = 0; s2l = 0; ap1.yp = ap2.yp = ap3.yp = ap4.yp = ap5.yp = 0; );   // bore starts from rest
    vt = 0;                                     // every new note restarts the vibrato delay
    stk[nheld] = m2; nheld += 1; lastnote = m2; gotnote = 1;
    freq = 440 * 2 ^ ((m2 - 69) / 12);
    nheld == 1 ? vtarget = 0.25 + 0.7 * (m3 / 127);
  ) : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    // a note-off releases only the OLDEST held copy of that pitch
    i = 0; fnd = -1;
    while (i < nheld && fnd < 0) ( stk[i] == m2 ? fnd = i; i += 1; );
    fnd >= 0 ? ( i = fnd; while (i < nheld - 1) ( stk[i] = stk[i + 1]; i += 1; ); nheld -= 1; );
